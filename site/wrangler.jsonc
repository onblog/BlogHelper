{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miaomiao-bar",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miaomiao-bar",
      "database_id": "fe66224a-d6c8-4d2a-b008-f993e702d7d8",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2_RELEASES",
      "bucket_name": "miaomiao-bar"
    }
  ],

  "routes": [
    {
      "pattern": "bar.wordtk.com",
      "custom_domain": true
    }
  ]
}
