{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miaomiao-bar",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Shared D1 database with sendtk / codetk / miaomiao-notes (`common`): the free plan
  // allows 10 databases and this site only keeps a handful of launch rows.
  // This project's table and indexes carry the `bar_` prefix (bar_launches +
  // idx_bar_launches_*). `d1_migrations` is a database-wide ledger keyed by file name,
  // so every file in migrations/ must include the project name — hence
  // `0001_bar_init.sql` instead of `0001_init.sql` (sendtk already recorded that name).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "common",
      "database_id": "ba170df9-05e6-427e-a081-099306e7fc77",
      "migrations_dir": "migrations"
    }
  ],

  // Installers live in the shared `common` R2 bucket (onblog / miaomiao-notes also
  // use it); every object key carries the `miaomiao-bar/` prefix to avoid collisions.
  "r2_buckets": [
    {
      "binding": "R2_RELEASES",
      "bucket_name": "common"
    }
  ],

  // 域名绑定不写在这里：生产域名属于部署配置，统一在 Cloudflare Dashboard 的
  // Worker → Settings → Domains & Routes 维护，仓库里不出现线上域名。
  "workers_dev": false
}
